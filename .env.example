# Turn this on in the paid API deployment. Keep it off for local development.
PKGGUARD_REQUIRE_API_KEY=true

# Provision keys from your billing system. Never commit real keys.
# Format: key=plan,key=plan where plan is free, pro, or team.
PKGGUARD_API_KEYS=pk_live_replace_me=pro

# Account and billing settings for the hosted API.
PKGGUARD_ACCOUNT_DB=/var/lib/pkgguard/accounts.sqlite3
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PKGGUARD_STRIPE_PRICE_PRO=price_replace_pro
PKGGUARD_STRIPE_PRICE_TEAM=price_replace_team
